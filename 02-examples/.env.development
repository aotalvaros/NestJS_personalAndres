# ========================================
# Development Environment (Sin Docker)
# ========================================

# Node
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orderdb

# Redis (local - opcional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (disabled for local development)
KAFKA_BROKER=localhost:9092
KAFKA_ENABLED=false

# RabbitMQ (disabled for local development)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ENABLED=false

# JWT/Auth
JWT_SECRET=dev-secret-key-change-in-prod
JWT_EXPIRES_IN=24h

# External APIs (Mocked)
STRIPE_API_KEY=sk_test_mocked_key
AWS_ACCESS_KEY=AKIA_MOCKED
AWS_SECRET_KEY=mocked_secret
