# ========================================
# Environment Variables - Order Service
# ========================================
# Copiar a .env y ajustar valores

# ======== Node ========
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ======== PostgreSQL ========
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orderdb

# ======== Redis ========
REDIS_HOST=localhost
REDIS_PORT=6379

# ======== Kafka ========
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=order-service-group

# ======== RabbitMQ ========
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ======== JWT/Auth ========
JWT_SECRET=your-super-secret-key-change-in-prod
JWT_EXPIRES_IN=24h

# ======== External APIs (Mocked) ========
STRIPE_API_KEY=sk_test_mocked_key
AWS_ACCESS_KEY=AKIA_MOCKED
AWS_SECRET_KEY=mocked_secret
